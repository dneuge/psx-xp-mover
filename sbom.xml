<?xml version='1.0' encoding='utf-8' ?>
<sbom xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tools/simple-sbom/simple-sbom.xsd">
    <product>
        <name>PSX/XP Mover</name>
        <description>plugin injecting PSX position data to X-Plane</description>
        <website>https://github.com/dneuge/psx-xp-mover</website>
        <source>https://github.com/dneuge/psx-xp-mover.git</source>
        <copyright license="MIT" years="2024-2026">
            <author>DanielNeugebauer</author>
        </copyright>
    </product>
    <dependencies>
        <dependency id="xplane">
            <name>X-Plane</name>
            <source>https://www.x-plane.com/</source>
            <method>provided</method>
            <developerRemark>runtime linked to via SDK</developerRemark>
            <copyright>
                <author>laminarResearch</author>
            </copyright>
        </dependency>
        <dependency id="xplane-sdk">
            <name>X-Plane SDK</name>
            <version>401</version>
            <source>https://developer.x-plane.com/wp-content/plugins/code-sample-generation/sdk_zip_files/XPSDK401.zip</source>
            <location>lib/XPSDK</location>
            <method>separate</method>
            <copyright license="xpsdk" years="2008">
                <author>SandyBarbour</author>
                <author>BenSupnik</author>
                <combinedAuthors>Sandy Barbour and Ben Supnik</combinedAuthors>
                <originalRemark>Copyright (c) 2008, Sandy Barbour and Ben Supnik</originalRemark>
            </copyright>
            <copyright license="xpsdk" years="2005-2022">
                <author>laminarResearch</author>
                <author>SandyBarbour</author>
                <author>BenSupnik</author>
                <combinedAuthors>Laminar Research, Sandy Barbour and Ben Supnik</combinedAuthors>
                <originalRemark>Copyright 2005-2022 Laminar Research, Sandy Barbour and Ben Supnik</originalRemark>
            </copyright>
            <dependency>xplane</dependency>
        </dependency>
        <dependency id="threads-macos-compat">
            <name>C11 threads compatibility wrapper for the macOS® operating system</name>
            <version>216bcaa5777532ecd0a07eac440ae876cfe7f119</version>
            <website>https://github.com/dneuge/c11-threads-compat-for-macos-operating-system</website>
            <source>https://github.com/dneuge/c11-threads-compat-for-macos-operating-system.git</source>
            <location>src/threads_macos_compat.h</location>
            <location>src/threads_macos_compat.c</location>
            <method>static</method>
            <activation>
                <tag>target-macos</tag>
            </activation>
            <copyright license="MIT" years="2024">
                <author>DanielNeugebauer</author>
            </copyright>
        </dependency>
    </dependencies>
